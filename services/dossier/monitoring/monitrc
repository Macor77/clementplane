# Hôte de recette du dossier professionnel, paquet Monit Debian.
set daemon 60
set log syslog
set idfile /var/lib/monit/id
set statefile /var/lib/monit/state
set eventqueue basedir /var/lib/monit/events slots 100
set ssl { verify: enable, cacertificatefile: /etc/ssl/certs/ca-certificates.crt }
include /etc/monit/clementplane/mail.conf
set mail-format {
  from: contact@clementplane.fr
  subject: Clementplane recette - RAM - $EVENT
  message: $DESCRIPTION
           $DATE
}

check system clementplane-recette
  if memory usage >= 70% for 5 cycles then alert else if succeeded for 3 cycles then alert
  if memory usage >= 90% then alert else if succeeded for 3 cycles then alert
